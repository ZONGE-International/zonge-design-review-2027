-content: center; gap: 3px; min-width: 38px; padding: 7px 0; }&#10; #geothermal-matrix .suitability i { display: block; width: 7px; height: 17px; background: #dce3e9; }&#10; #geothermal-matrix .suitability.level-1 i:nth-child(1), #geothermal-matrix .suitability.level-2 i:nth-child(-n+2), #geothermal-matrix .suitability.level-3 i { background: var(--blue); }&#10; #geothermal-matrix .precision-matrix-note { font-size: 14px; color: var(--muted); margin: 12px 0 22px; }&#10; @media(max-width:600px) { #geothermal-matrix .geo-table { min-width: 670px; display: table; } #geothermal-matrix .custom-modal-overlay { padding: 12px; } #geothermal-matrix .custom-modal { padding: 28px 20px; width:100%; } #geothermal-matrix .geo-header { min-width: 70px; } }&#10;&lt;/style&gt;&#10;&#10;&lt;div id="geothermal-matrix"&gt;&#10; &lt;h2 style="margin-bottom: 1rem;"&gt;Geothermal&lt;/h2&gt;&#10; &lt;p class="precision-matrix-note"&gt;Three bars indicate greater suitability. Select a cell for the technical explanation.&lt;/p&gt;</description></item><item><title>Groundwater Geophysical Survey Services</title><link>https://zonge-international.github.io/zonge-design-review-2027/targets/groundwater/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://zonge-international.github.io/zonge-design-review-2027/targets/groundwater/</guid><description>&lt;h2 id="groundwater-and-geophysics"&gt;Groundwater and Geophysics&lt;/h2&gt;&#10;&lt;p&gt;Zonge offers advanced geophysical services for groundwater exploration using electrical, electromagnetic (EM), and gravity methods. These non-invasive techniques provide quick, accurate assessments of subsurface conditions, helping to locate and map water-bearing formations. Our methods are environmentally friendly and ideal for guiding efficient drilling strategies.&lt;/p&gt;&#10;&lt;link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"&gt;&#10;&#10;&lt;style&gt;&#10; #groundwater-matrix {&#10; f