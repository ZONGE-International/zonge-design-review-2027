erflow-x: auto;&#10; }&#10;&#10; #geothermal-matrix .geo-cell {&#10; padding: 1.25rem;&#10; text-align: center;&#10; cursor: pointer;&#10; transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;&#10; font-size: 1.5rem;&#10; border-right: 1px solid rgba(117, 152, 199, 0.12);&#10; border-bottom: 1px solid rgba(117, 152, 199, 0.12);&#10; }&#10;&#10; #geothermal-matrix .geo-cell:hover {&#10; transform: translateY(-2px);&#10; box-shadow: inset 0 0 0 1px rgba(123, 191, 255, 0.18);&#10; }&#10;&#10; #geothermal-matrix .geo-header {&#10; color: #eaf3ff;&#10; font-weight: bold;&#10; padding: 1rem;&#10; font-size: 1.25rem;&#10; text-align: center;&#10; background: linear-gradient(180deg, rgba(18, 44, 76, 0.96), rgba(15, 35, 61, 0.96));&#10; border-right: 1px solid rgba(117, 152, 199, 0.14);&#10; border-bottom: 1px solid rgba(117, 152, 199, 0.14);&#10; letter-spacing: 0.04em;&#10; text-transform: uppercase;&#10; }&#10;&#10; #geothermal-matrix td:nth-child(even) {&#10; background-color: rgba(13, 29, 53, 0.84);&#10; }&#10;&#10; #geothermal-matrix td:nth-child(odd) {&#10; background-color: rgba(9, 21, 39, 0.84);&#10; }&#10;&#10; #geothermal-matrix tbody .geo-header {&#10; background: rgba(12, 29, 52, 0.94);&#10; color: #f5f9ff;&#10; text-transform: none;&#10; letter-spacing: 0;&#10; font-size: 1.15rem;&#10; }&#10;&#10; #geothermal-matrix .rating-thermometer {&#10; position: relative;&#10; display: inline-flex;&#10; align-items: flex-end;&#10; justify-content: center;&#10; width: 1rem;&#10; height: 2.2rem;&#10; }&#10;&#10; #geothermal-matrix .thermo-stem {&#10; position: absolute;&#10; bottom: 0.5rem;&#10; width: 0.48rem;&#10; height: 1.5rem;&#10; border-radius: 999px;&#10; border: 2px solid #7f8c8d;&#10; background: linear-gradient(180deg, #ffffff 0%, #eef2f3 100%);&#10; overflow: hidden;&#10; box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.55);&#10; }&#10;&#10; #geothermal-matrix .thermo-fill {&#10; position: absolute;&#10; left: 0;&#10; right: 0;&#10; bottom: 0;&#10; border-radius: 999px 999px 0 0;&#10; }&#10;&#10; #geothermal-matrix .thermo-bulb {&#10; position: absolute;&#10; bottom: 0;&#10; width: 1rem;&#10; height: 1rem;&#10; border-radius: 50%;&#10; border: 2px solid #7f8c8d;&#10; box-sizing: border-box;&#10; box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.45);&#10; }&#10;&#10; #geothermal-matrix .rating-thermometer.level-3 .thermo-fill {&#10; height: 100%;&#10; }&#10;&#10; #geothermal-matrix .rating-thermometer.level-2 .thermo-fill {&#10; height: 66%;&#10; }&#10;&#10; #geothermal-matrix .rating-thermometer.level-1 .thermo-fill {&#10; height: 33%;&#10; }&#10;&#10; #geothermal-matrix .rating-thermometer.thermo-red .thermo-fill,&#10; #geothermal-matrix .rating-thermometer.thermo-red .thermo-bulb {&#10; background: linear-gradient(180deg, #ff8c8c 0%, #d62828 100%);&#10; }&#10;&#10; #geothermal-matrix .rating-thermometer.thermo-yellow .thermo-fill,&#10; #geothermal-matrix .rating-thermometer.thermo-yellow .thermo-bulb {&#10; background: linear-gradient(180deg, #ffe690 0%, #d4a017 100%);&#10; }&#10;&#10; #geothermal-matrix .rating-thermometer.thermo-blue .thermo-fill,&#10; #geothermal-matrix .rating-thermometer.thermo-blue .thermo-bulb {&#10; background: linear-gradient(180deg, #95d5ff 0%, #2b6cb0 100%);&#10; }&#10;&#10; #geothermal-matrix .custom-modal-overlay {&#10; position: absolute;&#10; top: 0;&#10; left: 0;&#10; right: 0;&#10; bottom: 0;&#10; padding: 1.5rem;&#10; background: rgba(0, 0, 0, 0.6);&#10; display: flex;&#10; align-items: center;&#10; justify-content: center;&#10; visibility: hidden;&#10; opacity: 0;&#10; transition: opacity 0.3s ease, visibility 0.3s ease;&#10; z-index: 20;&#10; border-radius: 20px;&#10; }&#10;&#10; #geothermal-matrix .custom-modal-overlay.active {&#10; visibility: visible;&#10; opacity: 1;&#10; }&#10;&#10; #geothermal-matrix .custom-modal {&#10; background: linear-gradient(180deg, rgba(10, 22, 40, 0.98), rgba(8, 18, 33, 0.98));&#10; padding: 2rem;&#10; border-radius: 1rem;&#1